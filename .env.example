# Copy to .env at the repo root. Real environment variables take precedence.
CLAUDE_API_KEY=            # shared event key — required for live mode
CLAUDE_BASE_URL=           # hackathon proxy base, e.g. https://proxy.example.com
CLAUDE_MODEL=claude-sonnet-5
LISTING_SOURCE=scrape      # scrape | api
GEO_GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEO_OVERPASS_URL=https://overpass-api.de/api/interpreter
GEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation

# --- v2 additions (Task 10) ---
HARMONIQ_DB=                   # SQLite file path, default ./.harmoniq-local/harmoniq.db
HARMONIQ_OBJECT_STORE=         # report-body object store root, default ./.harmoniq-local/store
ORIENTATION_PROVIDER=fixture   # fixture | sightmap
SIGHTMAP_API_KEY=              # required only when ORIENTATION_PROVIDER=sightmap
SIGHTMAP_BASE_URL=https://api.sightmap.com/v1
SCORING_MODE=interactive       # interactive | batch
BATCH_API_ENABLED=false
GEO_SNAPSHOT_TTL_DAYS=90
TASKZERO_SAMPLE_N=20
